\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamer-floral}[2026/11/12 v0.2.0 Generic floral background for beamer]

% A beamerarticle version of a talk shares the preamble and has no slides to
% decorate, so the public commands accept their arguments and do nothing.
\@ifclassloaded{beamer}{}{%
  \PackageInfo{beamer-floral}{Not a beamer document; flora is disabled}%
  \providecommand\florasetup[1]{}%
  \providecommand\florathisframe[1]{}%
  \providecommand\florathispage[1]{}%
  \providecommand\florapalette[1]{}%
  \providecommand\floraon{}%
  \providecommand\floraoff{}%
  \providecommand\florareserve[4]{}%
  \providecommand\floraclearreserve{}%
  \providecommand\florabackground[3][]{}%
  \expandafter\endinput
}

\RequirePackage{tikzflora}
% A useful floral border needs space, whichever Beamer theme supplies the text.
% Set document-specific margins after loading this package to override them.
\setbeamersize{text margin left=2.5cm,text margin right=1cm}
\newcount\floraltitlepageflag
% Set by a section page template that wants the section composition (the
% Floral theme's [floral] template); other themes' section pages leave it 0.
\newcount\floralsectionpageflag
% The page's class for reuse: 0 content, 1 title, 2 section. Hooks on
% Beamer's own commands see every theme's title and section pages.
\newcount\floralpageclass
% Reset after Beamer has shipped the preceding slide, before this body.
\AddToHook{cmd/beamer@framenotesbegin/before}{\global\floraltitlepageflag=0\relax\global\floralsectionpageflag=0\relax\global\floralpageclass=0\relax}
\AddToHook{cmd/titlepage/before}{\global\floralpageclass=1\relax}
\AddToHook{cmd/sectionpage/before}{\global\floralpageclass=2\relax}
\AddToHook{cmd/titlepage/before}{\directlua{beamer_floral.stage_check()}}
\AddToHook{cmd/sectionpage/before}{\directlua{beamer_floral.stage_check()}}

% The stage layout (stage, stage width, stage margin; see the manual).
% Beamer reads the text margins when a frame starts and \setbeamersize works only in
% the preamble, so the margin and width registers are assigned directly,
% globally, at the start of every frame. \floralstagerestore returns to the
% margins taken when the document began. Beamer's columns spread over the
% whole slide unless onlytextwidth is on, which would run them into the stage,
% so a stage frame turns it on and the restore puts the document's value back.
\makeatletter
\newif\iffloralenvframe
\AddToHook{cmd/frame/before}{%
  \ifx\@currenvir\beamer@frametext\global\floralenvframetrue\else\global\floralenvframefalse\fi}
\AddToHook{cmd/beamer@framecommand/before}{%
  \iffloralenvframe
    \directlua{beamer_floral.stage_begin("\luaescapestring{\detokenize\expandafter{\the\beamer@envbody}}",
      \iffloraon true\else false\fi)}%
  \else
    \directlua{beamer_floral.stage_begin(nil, \iffloraon true\else false\fi)}%
  \fi}
\newcommand\floralstagemargins[2]{%
  \global\beamer@leftmargin=\dimexpr#1\relax
  \global\beamer@rightmargin=\dimexpr#2\relax
  \global\beamer@onlytextwidthtrue
  \floral@stagegeometry}
\newcommand\floralstagerestore{%
  \global\beamer@leftmargin=\floral@baseleft
  \global\beamer@rightmargin=\floral@baseright
  \floral@baseonlytext
  \floral@stagegeometry}
\newdimen\floral@baseleft \newdimen\floral@baseright
\let\floral@baseonlytext\relax
\newcommand\floral@stagegeometry{%
  \global\textwidth=\dimexpr\paperwidth-\beamer@leftmargin-\beamer@leftsidebar
    -\beamer@rightmargin-\beamer@rightsidebar\relax
  \global\oddsidemargin=\dimexpr\beamer@leftmargin+\beamer@leftsidebar-1in-\hoffset\relax
  \global\evensidemargin=\oddsidemargin
  % Beamer's page style draws the canvas, headline, footline and sidebars
  % from \oddsidemargin back to the page edge with these geometry macros;
  % they are derived from the margins, so a restore puts the document's back.
  \xdef\Gm@lmargin{\the\dimexpr\beamer@leftmargin+\beamer@leftsidebar\relax}%
  \xdef\Gm@rmargin{\the\dimexpr\beamer@rightmargin+\beamer@rightsidebar\relax}%
  \global\columnwidth=\textwidth \global\linewidth=\textwidth \global\hsize=\textwidth}
\makeatother

\directlua{%
  if flora.prepare_spec_version ~= 1 then
    tex.error("beamer-floral needs tikz-flora 39cfd26 or later (prepare_spec hook missing)")
  end
  beamer_floral = dofile(kpse.find_file("beamer-floral.lua", "tex"))
  local directory = status.output_directory
  local path = (directory and directory ~= "" and directory .. "/" or "") .. tex.jobname .. ".floral-cache"
  beamer_floral.init(path)
  local original = flora.page
  flora.page = function(a)
    local document_settings = flora.settings
    local title_page = tex.count.floraltitlepageflag == 1
    if beamer_floral.frame then title_page = beamer_floral.frame.title_preset end
    beamer_floral.page_title = title_page
    if title_page and beamer_floral.title_defaults then
      flora.settings = require("flora.settings").merge(flora.settings, beamer_floral.title_defaults)
    end
    local section_page = tex.count.floralsectionpageflag == 1
    if beamer_floral.frame then section_page = beamer_floral.frame.section_preset end
    beamer_floral.page_section = section_page
    if section_page and not title_page and beamer_floral.section_defaults then
      flora.settings = require("flora.settings").merge(flora.settings, beamer_floral.section_defaults)
    end
    if beamer_floral.plain and beamer_floral.plain_defaults then
      flora.settings = require("flora.settings").merge(flora.settings, beamer_floral.plain_defaults)
    end
    beamer_floral.active_settings = require("flora.settings").merge(flora.settings, flora.once)
    beamer_floral.pending = flora.once
    beamer_floral.input_signature = require("flora.serial").encode{
      seed=a.seed, background_position=a.background_position,
      background_height=a.background_height, background_color=a.background_color}
    local previous = a.prepare_spec
    a.prepare_spec = function(spec)
      if previous then previous(spec) end
      % A caller's own renderer draws its frame; such a frame is never reused.
      beamer_floral.custom_render = a.render_page ~= nil
      beamer_floral.prepare(spec)
      if beamer_floral.frame.growth.growth ~= "off" and not beamer_floral.handout then
        if flora.render_page_version ~= 1 then
          tex.error("beamer-floral growth needs tikz-flora with render_page_version=1")
        end
        local previous_render = a.render_page
        a.render_page = function(spec, args)
          local rendered = beamer_floral.render_page(spec, args)
          if rendered ~= nil then return rendered end
          if previous_render then return previous_render(spec, args) end
        end
      elseif beamer_floral.frame.reuse and not a.render_page
          and flora.render_page_version == 1 then
        a.render_page = beamer_floral.render_reused
      elseif beamer_floral.stages > 1 and not beamer_floral.handout
          and not a.render_page and flora.render_page_version == 1 then
        a.render_page = beamer_floral.render_static
      end
    end
    local result = original(a)
    flora.settings = document_settings
    return result
  end
}
\makeatletter
\AddToHook{shipout/before}{%
  \directlua{beamer_floral.context("\beamer@framestartpage", \the\beamer@autobreakcount,
    \iffloraon true\else false\fi, \ifbeamer@plainframe true\else false\fi)}%
}
\AddToHook{enddocument/afterlastpage}{\directlua{beamer_floral.finish()}}
% In Beamer the next-page convenience command applies to the whole frame.
\let\florathisframe\florathispage
\makeatother

% One symbol from the header-aware engine fork; older checkouts would
% otherwise fail later with an unrelated error.
\ifcsname floraframetitlepresent\endcsname\else
  \PackageError{beamer-floral}{This package needs the krissen/tikz-flora fork}%
    {Point TIKZFLORA at a checkout of the fork's branch beamer-floral, commit
     39cfd26 or later, or set it in a local .env. The upstream engine lacks
     the header modes and the beamer tune keys.}%
\fi
% Reused pages paint their running-head marks with compose.mark_layout, and
% every mark kind must stay inside its box; compose.MARK.clear, the mark's
% obstacle clearance, arrives with both, in 39cfd26.
\directlua{%
  local ok, t = pcall(require, "flora.tune")
  local missing
  if not ok or not t.gesture or t.gesture.mark_min == nil then
    missing = "gesture.mark_min"
  else
    local found, C = pcall(require, "flora.compose")
    if not found or type(C.mark_layout) ~= "function" or not C.MARK or C.MARK.clear == nil then
      missing = "compose.MARK.clear"
    end
  end
  if missing then
    tex.error("beamer-floral needs krissen/tikz-flora 39cfd26 or later "
      .. "(" .. missing .. " missing)")
  end
}

% Thin, tapered stems and a surround border are the package defaults.
\florasetup{layout=surround, header=body,
  tune={plant={root=0.78, root_width=2.2, tip_width=1.2, stem_brush=0.5,
    end_taper=0.06, fork_ratio=0.8},
    gesture={edge=0.10}}}

% Beamer builds and unboxes the title box inside \beamer@frameslide; catch
% its dimensions between the two. The box is empty at shipout.
\makeatletter
\renewcommand\floratitleheight{0pt}
\patchcmd{\endbeamer@frameslide}
  {\beamer@frametextheight=\textheight}
  {\beamer@frametextheight=\textheight
   \xdef\floratitleheight{\the\dimexpr\ht\beamer@frametitlebox+\dp\beamer@frametitlebox\relax}}
  {}{\PackageError{beamer-floral}{Could not capture the frame title height}%
    {The Beamer frame implementation has changed. Update the floral adapter before compiling.}}
\patchcmd{\endbeamer@frameslide}
  {\beamer@frametextheight=\paperheight}
  {\beamer@frametextheight=\paperheight
   \xdef\floratitleheight{\the\dimexpr\ht\beamer@frametitlebox+\dp\beamer@frametitlebox\relax}}
  {}{\PackageError{beamer-floral}{Could not capture the plain frame title height}%
    {The Beamer frame implementation has changed. Update the floral adapter before compiling.}}
\renewcommand\floraframetitlepresent{\ifdim\floratitleheight>0pt 1\else 0\fi}
\makeatother

% The flora is painted in shipout/background, behind beamer's background
% canvas. Leave that canvas empty so the page's own colour does not cover
% the flowers; a document that wants a filled canvas can set it again.
\setbeamertemplate{background canvas}{}

% Named palettes. Each is a set of inks for the engine's parts; pass one of
% them to \florapalette, or set any part with \florasetup{palette=...}.
%   warm         gold hero and sprays, warm blooms, earth leaves and stems
%   blue         gold hero and sprays, blue blooms, leaves and leaflets
%   green        gold hero and sprays, blue blooms, green leaves and leaflets
%   green-stems  as green, with green stems
\makeatletter
% A beamer colour theme may follow the chosen palette; beamer-floral itself
% sets only the engine's inks.
\providecommand\florapalettehook[1]{}
\newcommand\florapalette[1]{%
  \@ifundefined{florapalette@#1}%
    {\PackageError{beamer-floral}{Unknown floral palette `#1'}%
      {Known palettes: warm, blue, green, green-stems.}}%
    {\@nameuse{florapalette@#1}}}
\newcommand\florapalette@warm{%
  \florasetup{palette={hero=gold, blooms=warm, leaves=earth, leaflets=blue,
    stems=earth, sprays=gold, ghost=warm}}\florapalettehook{warm}}
\newcommand\florapalette@blue{%
  \florasetup{palette={hero=gold, blooms=blue, leaves=blue, leaflets=blue,
    stems=earth, sprays=gold, ghost=blue}}\florapalettehook{blue}}
\newcommand\florapalette@green{%
  \florasetup{palette={hero=gold, blooms=blue, leaves=green, leaflets=green,
    stems=earth, sprays=gold, ghost=blue}}\florapalettehook{green}}
\newcommand\florapalette@green@stems{%
  \florasetup{palette={hero=gold, blooms=blue, leaves=green, leaflets=green,
    stems=green, sprays=gold, ghost=blue}}\florapalettehook{green-stems}}
\expandafter\let\csname florapalette@green-stems\endcsname\florapalette@green@stems

% The generic look is the warm palette; a theme may pick another.
\florapalette{warm}

\AtBeginDocument{%
  \mode<handout>{\directlua{beamer_floral.handout=true}}%
  \floral@baseleft=\beamer@leftmargin \floral@baseright=\beamer@rightmargin
  \ifbeamer@onlytextwidth\gdef\floral@baseonlytext{\global\beamer@onlytextwidthtrue}%
  \else\gdef\floral@baseonlytext{\global\beamer@onlytextwidthfalse}\fi
  \floratextblockx{\the\beamer@leftmargin}{\the\dimexpr\paperwidth-\beamer@rightmargin\relax}%
  \ifdim\beamer@leftsidebar>0pt
    \floral@sidebarwarning
  \else\ifdim\beamer@rightsidebar>0pt
    \floral@sidebarwarning
  \fi\fi
}
\newcommand\floral@sidebarwarning{%
  \PackageWarningNoLine{beamer-floral}{Sidebar theme detected. The sidebar and flora share margin space; this combination is not visually supported. See Limitations in the manual}}
\makeatother

\endinput
